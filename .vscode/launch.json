{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        // gdb remote to localhost:3333 on qemu
        {
            "name": "gdb remote to localhost:3333 on qemu",
            "type": "gdb",
            "request": "attach",
            "remote": true,
            "target": "localhost:3333",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/target/build/qos.elf",
            "gdbpath": "/usr/bin/gdb-multiarch",
            "preLaunchTask": "launch gdb-server",
            "autorun": [
                "symbol-file ${workspaceFolder}/target/build/qos.elf"
            ]
        },
        {
            "name": "QEMU GDB",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/build/qos.elf",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "riscv64-unknown-elf-gdb",
            "miDebuggerArgs": "--interpreter=mi2",
            "miDebuggerServerAddress": "localhost:3333",
            "preLaunchTask": "launch gdb-server",
            "setupCommands": [
                {
                    "description": "Enable Rust pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}