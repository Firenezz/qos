{
    // Requires nix develop .#gdb-riscv (or scripts/riscv64-gdb.sh) + OVMF_*.
    // preLaunchTask: just run-riscv64-gdb (-S -gdb tcp::3333) after iso-build.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "QEMU GDB (cppdbg)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/qos-kernel.elf",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${workspaceFolder}/scripts/riscv64-gdb.sh",
            "miDebuggerArgs": "--interpreter=mi2",
            "miDebuggerServerAddress": "localhost:3333",
            "preLaunchTask": "launch gdb-server",
            "setupCommands": [
                {
                    "description": "RISC-V architecture",
                    "text": "set architecture riscv:rv64",
                    "ignoreFailures": false
                },
                {
                    "description": "Search DWARF sources from repo root",
                    "text": "set directories ${workspaceFolder}",
                    "ignoreFailures": true
                },
                {
                    "description": "Reload unstripped kernel ELF (DWARF + symtab)",
                    "text": "file ${workspaceFolder}/build/qos-kernel.elf",
                    "ignoreFailures": false
                },
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Break at kernel entry",
                    "text": "break boot_main",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "QEMU LLDB (Native Debug)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/qos-kernel.elf",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "launch gdb-server",
            "initCommands": [
                "settings set target.default-arch riscv64",
                "target create ${workspaceFolder}/build/qos-kernel.elf"
            ],
            "processCreateCommands": [
                "gdb-remote localhost:3333",
                "continue"
            ]
        }
    ]
}
