{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "just: build",
            "type": "shell",
            "command": "just build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "just: iso-build",
            "type": "shell",
            "command": "just iso-build",
            "group": "build",
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "launch gdb-server",
            "type": "shell",
            "command": "just run-riscv64-gdb",
            "isBackground": true,
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false
            },
            "problemMatcher": {
                "owner": "qemu-gdb",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "GDB server listening on localhost:3333"
                }
            }
        }
    ]
}
