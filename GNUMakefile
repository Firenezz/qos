# Nuke built-in rules and variables.
override MAKEFLAGS += -rR

override IMAGE_NAME := qos

# Convenience macro to reliably declare user overridable variables.
define DEFAULT_VAR =
    ifeq ($(origin $1),default)
        override $(1) := $(2)
    endif
    ifeq ($(origin $1),undefined)
        override $(1) := $(2)
    endif
endef

# Set target absolute path
export TARGET_DIR := ${CURDIR}/target
export ROOT_DIR := ${CURDIR}

# Set build directory
export BUILD_DIR := target/build/
export BUILD_LIMINE := ${BUILD_DIR}limine

override DEFAULT_ARCH := riscv64
$(eval $(call DEFAULT_VAR,ARCH,$(DEFAULT_ARCH)))

# Set the OVMF path for the ARCH
override OVMF_PATH := OVMF/${ARCH}
override OVMF_CODE := ${OVMF_PATH}/code.fd
override OVMF_VARS := ${OVMF_PATH}/vars.fd
override OVMF_SHELL := ${OVMF_PATH}/shell.efi

override QEMU_SYSTEM := qemu-system-$(ARCH)
QEMU_SYSTEM_FLAGS := -M virt,pflash0=pflash0,pflash1=pflash1,acpi=on
QEMU_SYSTEM_FLAGS += -device virtio-gpu-pci -device qemu-xhci -device usb-kbd -device virtio-rng-pci -netdev user,id=net0 -device virtio-net-pci,netdev=net0
QEMU_SYSTEM_FLAGS += -blockdev node-name=pflash0,driver=file,read-only=on,filename=$(OVMF_CODE)
QEMU_SYSTEM_FLAGS += -blockdev node-name=pflash1,driver=file,filename=$(OVMF_VARS)
#QEMU_SYSTEM_FLAGS += -serial mon:stdio -nographic
QEMU_SYSTEM_FLAGS += -display gtk

# Set bootloader
override BOOTLOADER := limine
override BOOTLOADER_PATH := boot/qos-${BOOTLOADER}
override BOOTLOADER_ELF := ${BOOTLOADER_PATH}/kernel.elf

include GNUMakefile.limine

.PHONY: all
all: $(IMAGE_NAME).iso

.PHONY: all-hdd
all-hdd: $(IMAGE_NAME).hdd

OVMF:
	mkdir -p OVMF
	cd OVMF && curl -Lo OVMF.fd https://retrage.github.io/edk2-nightly/bin/RELEASEX64_OVMF.fd

.PHONY: run-uefi
run-uefi: $(IMAGE_NAME).iso
	$(QEMU_SYSTEM) $(QEMU_SYSTEM_FLAGS) -m 4G -smp 2 -drive file=$(BUILD_DIR)$(IMAGE_NAME).iso,format=raw,id=cd0 -device virtio-blk-device,drive=cd0

.PHONY: run-hdd-uefi
run-hdd-uefi: $(IMAGE_NAME).hdd
	$(QEMU_SYSTEM) $(QEMU_SYSTEM_FLAGS) -m 4G -smp 2 -boot d -hda $(BUILD_DIR)$(IMAGE_NAME).hdd

.PHONY: run-uefi-dumpdts
run-uefi-dumpdts: $(IMAGE_NAME).iso
	$(QEMU_SYSTEM) -m 4G -smp 2 -boot d -drive file=$(BUILD_DIR)$(IMAGE_NAME).iso,media=cdrom $(QEMU_SYSTEM_FLAGS) -machine dumpdtb=qemu.dtb
	dtc -I dtb -O dts qemu.dtb > qemu.dts

.PHONY: kernel
kernel:
	$(MAKE) -f GNUMakefile -C $(BOOTLOADER_PATH)

$(IMAGE_NAME).iso: limine kernel
	rm -rf iso_root
	rm -f $(BUILD_DIR)$(IMAGE_NAME).iso
	mkdir -p iso_root/EFI/BOOT
	cp -v limine.cfg iso_root/
	cd $(BUILD_DIR) && cp -v qos.elf \
		limine/limine-bios.sys limine/limine-bios-cd.bin limine/limine-uefi-cd.bin $(ROOT_DIR)/iso_root/
	cd $(BUILD_DIR) && cp -v limine/BOOTX64.EFI $(ROOT_DIR)/iso_root/EFI/BOOT/
	cd $(BUILD_DIR) && cp -v limine/BOOTIA32.EFI $(ROOT_DIR)/iso_root/EFI/BOOT/
	cd $(BUILD_DIR) && cp -v limine/BOOTRISCV64.EFI $(ROOT_DIR)/iso_root/EFI/BOOT/
	cd $(BUILD_DIR) && xorriso -as mkisofs -b limine-bios-cd.bin \
		-no-emul-boot -boot-load-size 4 -boot-info-table \
		-eltorito-alt-boot \
		--efi-boot limine-uefi-cd.bin \
		-efi-boot-part --efi-boot-image --protective-msdos-label \
		$(ROOT_DIR)/iso_root -o $(IMAGE_NAME).iso
	cd $(BUILD_DIR) && ./limine/limine bios-install $(IMAGE_NAME).iso
	rm -rf iso_root

$(IMAGE_NAME).hdd: limine kernel
	rm -f $(BUILD_DIR)$(IMAGE_NAME).hdd
	cd $(BUILD_DIR) && dd if=/dev/zero bs=1M count=0 seek=64 of=$(IMAGE_NAME).hdd
	cd $(BUILD_DIR) && sgdisk $(IMAGE_NAME).hdd -n 1:2048 -t 1:ef00
	cd $(BUILD_DIR) && ./limine/limine bios-install $(IMAGE_NAME).hdd
	cd $(BUILD_DIR) && mformat -i $(IMAGE_NAME).hdd@@1M
	cd $(BUILD_DIR) && mmd -i $(IMAGE_NAME).hdd@@1M ::/EFI ::/EFI/BOOT
	mcopy -i $(BUILD_DIR)$(IMAGE_NAME).hdd@@1M $(BUILD_DIR)qos.elf limine.cfg $(BUILD_DIR)limine/limine-bios.sys ::/
	mcopy -i $(BUILD_DIR)$(IMAGE_NAME).hdd@@1M $(BUILD_DIR)limine/BOOTX64.EFI ::/EFI/BOOT
	mcopy -i $(BUILD_DIR)$(IMAGE_NAME).hdd@@1M $(BUILD_DIR)limine/BOOTIA32.EFI ::/EFI/BOOT

.PHONY: run-gdb-server
run-gdb-server: $(IMAGE_NAME).iso
	$(QEMU_SYSTEM) $(QEMU_SYSTEM_FLAGS) -m 8G -smp 4 -drive file=$(BUILD_DIR)$(IMAGE_NAME).iso,format=raw,id=cd0 -device virtio-blk-device,drive=cd0 -S -gdb tcp::3333

.PHONY: run-gdb-client
run-gdb-client:
	riscv64-unknown-elf-gdb -ex "target remote localhost:3333" -ex "symbol-file $(BUILD_DIR)qos.elf" -ex "break boot_main"

.PHONY: clippy
clippy:
	$(MAKE) -f GNUMakefile -C $(BOOTLOADER_PATH) clippy

.PHONY: clean
clean:
	rm -rf iso_root $(IMAGE_NAME).iso $(IMAGE_NAME).hdd
	cargo clean
	$(MAKE) -f GNUMakefile -C $(BOOTLOADER_PATH) clean

.PHONY: distclean
distclean: clean
	rm -rf limine ovmf
	$(MAKE) -f GNUMakefile -C $(BOOTLOADER_PATH) distclean

.PHONY: setup-env
setup-env:
	sudo apt-get install gdisk mtools xorriso